# ── TwinForge AI — Environment Variables ─────────────────
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── Application ──────────────────────────────────────────
APP_NAME=TwinForge AI
APP_ENV=development
APP_VERSION=0.1.0
DEBUG=true

# ── Backend ──────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
SECRET_KEY=change-this-to-a-secure-random-string-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Database ─────────────────────────────────────────────
DATABASE_URL=postgresql://twinforge:password@localhost:5432/twinforge_db
POSTGRES_USER=twinforge
POSTGRES_PASSWORD=password
POSTGRES_DB=twinforge_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ── Frontend ─────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws
VITE_APP_NAME=TwinForge AI

# ── AI ───────────────────────────────────────────────────
AI_MODEL_PATH=ai/models/prediction_model.pkl
FACTORY_ASSISTANT_MODEL=claude-sonnet-4-6
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# ── MQTT / IoT ───────────────────────────────────────────
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=twinforge

# ── Email (Alerts) ───────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=alerts@yourdomain.com
SMTP_PASSWORD=your-smtp-password

# ── Thresholds ───────────────────────────────────────────
TEMP_WARNING_C=75
TEMP_CRITICAL_C=90
VIBRATION_WARNING_MMS=5.0
VIBRATION_CRITICAL_MMS=8.0
HEALTH_WARNING_THRESHOLD=60
HEALTH_CRITICAL_THRESHOLD=30
